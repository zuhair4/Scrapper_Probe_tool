{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/proxy/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|proxy/).*)",
      "destination": "/index.html"
    }
  ]
}
